# Solicitar número entero válido
while True:
    try:
        numero = int(input("Ingrese un número entero: "))
        break
    except ValueError:
        print("Error: debe ingresar un número entero.")

# Mostrar tabla de multiplicar
print(f"\nTabla del {numero}")

for i in range(1, 11):
    print(f"{numero} x {i} = {numero * i}")